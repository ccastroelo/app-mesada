rules_version = '2';

// ADR-0011. Publicar (firebase deploy --only firestore:rules) só com aprovação
// do usuário e depois de passar nos testes de firebase-tests/.
//
// Acesso por família: quem tem /families/{fid}/members/{uid} é membro.
// Entrar numa família exige um convite válido (código de uso único, 48 h).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }

    function isShortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Preferências e vínculo do próprio usuário.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId'])
        && request.resource.data.familyId is string;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      allow read: if isMember(fid);

      // Quem cria vira o criador; o próprio cliente grava o documento de membro
      // em seguida (ver regra de members).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && isShortText(request.resource.data.name, 60)
        && request.resource.data.createdAt == request.time;

      // Só o nome pode mudar.
      allow update: if isMember(fid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && isShortText(request.resource.data.name, 60);

      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(fid);

        // 1) Criador entra na própria família logo após criá-la.
        // 2) Convidado entra apresentando um código válido, consumido no mesmo lote.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'joinedAt', 'code'])
          && request.resource.data.joinedAt == request.time
          && (
            getAfter(/databases/$(database)/documents/families/$(fid)).data.createdBy == request.auth.uid
            || (
              request.resource.data.code is string
              && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.familyId == fid
              && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.usedBy == null
              && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.expiresAt > request.time
              && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.usedBy == request.auth.uid
            )
          );

        // "Sair da família": cada um remove só o próprio vínculo.
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /children/{id} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid)
          && isShortText(request.resource.data.name, 60)
          && request.resource.data.allowanceCents is int
          && request.resource.data.allowanceCents >= 0
          && request.resource.data.allowanceCents <= 99999999
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 120;
      }

      match /rules/{id} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid)
          && isShortText(request.resource.data.description, 120)
          && request.resource.data.valueCents is int
          && request.resource.data.valueCents >= -99999
          && request.resource.data.valueCents <= 99999;
      }

      // Um documento por par filho × regra; id = "<childId>_<ruleId>".
      match /entries/{id} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid)
          && request.resource.data.childId is string
          && request.resource.data.ruleId is string
          && id == request.resource.data.childId + '_' + request.resource.data.ruleId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0
          && request.resource.data.enabled is bool;
      }
    }

    // Quem tem o código lê o convite (get), mas ninguém lista convites.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if isMember(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId', 'createdBy', 'expiresAt', 'usedBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(48, 'h');

      // Consumir: só marcar usedBy com o próprio uid, e só se virou membro no mesmo lote.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid));

      allow delete: if isMember(resource.data.familyId);
    }
  }
}
